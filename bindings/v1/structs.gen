    "normalZ", sol::property(&FloorGeometry::normalZ, &FloorGeometry::normalZ),
    "originOffset", sol::property(&FloorGeometry::originOffset, &FloorGeometry::originOffset)
);

lua.new_usertype<SurfaceNode>("SurfaceNode",
    "next", sol::property(&SurfaceNode::next, &SurfaceNode::next),
    "surface", sol::property(&SurfaceNode::surface, &SurfaceNode::surface)
);

lua.new_usertype<IEvent>("IEvent",
    "cancelled", sol::property(&IEvent::cancelled, &IEvent::cancelled)
);

lua.new_usertype<EventListener>("EventListener",
    "priority", sol::property(&EventListener::priority, &EventListener::priority),
    "function", sol::property(&EventListener::function, &EventListener::function)
);
